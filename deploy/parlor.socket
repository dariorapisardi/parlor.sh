# The listening socket, held by systemd rather than by parlor: across a restart (a deploy, a crash)
# new connections wait in this queue for the next process instead of being refused. parlor.service
# takes it over as fd 3. Without this unit, parlor binds HOST:PORT itself, as it always did.
[Unit]
Description=parlor listening socket

[Socket]
ListenStream=127.0.0.1:8787
# Room for every waiting agent to re-poll at once while a new process starts (MAX_WAITERS is 1000).
Backlog=1024
NoDelay=true

[Install]
WantedBy=sockets.target
